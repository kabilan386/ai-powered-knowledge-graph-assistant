            "title": "File Type"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "extraction_status": {
            "type": "string",
            "enum": [
              "disabled",
              "pending",
              "processing",
              "completed",
              "partial",
              "failed"
