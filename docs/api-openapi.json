            "type": "array",
            "title": "Source Citations"
          },
          "document_backed": {
            "type": "boolean",
            "title": "Document Backed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "type",
          "source_id",
          "target_id"
        ],
        "title": "FusedEdge"
      },
      "GraphEdge": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/RelationshipEvidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "evidence_truncated": {
            "type": "boolean",
            "title": "Evidence Truncated",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "type",
          "source_id",
          "target_id"
        ],
        "title": "GraphEdge"
      },
      "GraphEntity": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "title": "GraphEntity"
      },
      "GraphNode": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "title": "GraphNode"
      },
      "GraphPath": {
        "properties": {
          "hop_count": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Hop Count"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphEntity"
            },
            "type": "array",
            "title": "Nodes"
          },
          "relationships": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Relationships"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            },
            "type": "array",
            "title": "Edges"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "default": 0
