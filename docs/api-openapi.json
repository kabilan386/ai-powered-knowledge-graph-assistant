          "insufficient_evidence": {
            "type": "boolean",
            "title": "Insufficient Evidence"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "citations",
          "sources",
          "retrieval",
          "insufficient_evidence"
        ],
        "title": "AskResponse"
      },
      "BackfillRequest": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "limit": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 100
          }
        },
        "type": "object",
        "title": "BackfillRequest"
      },
      "BackfillResponse": {
        "properties": {
          "processed": {
            "type": "integer",
            "title": "Processed",
            "default": 0
          },
          "updated": {
            "type": "integer",
            "title": "Updated",
            "default": 0
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped",
            "default": 0
          },
          "remaining": {
            "type": "integer",
            "title": "Remaining",
            "default": 0
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/EmbeddingFailure"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "title": "BackfillResponse"
      },
      "Body_upload_document_api_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
