            "title": "Extraction Status",
            "default": "disabled"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "file_type",
          "created_at"
        ],
        "title": "Document"
      },
      "EmbeddingFailure": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "code"
        ],
        "title": "EmbeddingFailure"
      },
      "EmbeddingSummary": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "disabled",
              "pending",
              "completed",
              "partial",
              "failed"
            ],
            "title": "Status",
            "default": "disabled"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total",
            "default": 0
          },
          "completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completed",
            "default": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Failed",
            "default": 0
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/EmbeddingFailure"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "title": "EmbeddingSummary"
      },
      "ExtractionSummary": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "disabled",
              "pending",
              "processing",
              "completed",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "default": 0
          },
          "completed": {
            "type": "integer",
            "title": "Completed",
            "default": 0
          },
          "failed": {
            "type": "integer",
            "title": "Failed",
            "default": 0
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ChunkExtractionError"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ExtractionSummary"
      },
      "FusedEdge": {
        "properties": {
          "type": {
            "type": "string",
