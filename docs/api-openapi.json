          "excerpt_truncated": {
            "type": "boolean",
            "title": "Excerpt Truncated",
            "default": false
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphEntity"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/FusedEdge"
            },
            "type": "array",
            "title": "Edges"
          },
          "supporting_citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supporting Citations"
          }
        },
        "type": "object",
        "required": [
          "citation",
          "kind"
        ],
        "title": "CitationSource"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "txt"
